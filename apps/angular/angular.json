                "output": "/"
              }
            ],
            "styles": [
              "projects/ordering-mfe/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ordering-mfe/**/*.ts",
              "projects/ordering-mfe/**/*.html"
            ]
          }
        }
      }
    }
  }
}
