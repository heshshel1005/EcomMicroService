            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ordering-mfe/public",
                "output": "/"
              }
            ],
            "styles": [
              "projects/ordering-mfe/src/styles.scss"
            ],
            "scripts": [],
            "commonChunk": false,
            "customWebpackConfig": {
              "path": "projects/ordering-mfe/webpack.config.js"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
